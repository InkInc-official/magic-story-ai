generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas  = ["magic_story"]
}

// ==========================================
// 核心项目模型
// ==========================================

model Project {
  id          String   @id @default(cuid())
  title       String
  genre       String   @default("玄幻系统修仙")
  description String   @default("")
  coverImage  String   @default("")
  narrativePerspective String?
  defaultPovCharacterId String?
  povNotes String @default("")
  writingStyleNotes String @default("")
  defaultChapterTarget Int?
  chapterLengthPolicy String @default("guide")
  formattingNotes String @default("")
  authorIntent String @default("")
  genreGuidanceMode String @default("reference")
  genreGuidanceNotes String @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  worldSettings       WorldSetting[]
  characters          Character[]
  characterRelations  CharacterRelationship[]
  outlines            Outline[]
  chapters            Chapter[]
  promptTemplates     PromptTemplate[]
  agentLogs           AgentLog[]
  storyStates         StoryState[]
  foreshadowings      Foreshadowing[]
  storyFacts          StoryFact[]
  storyNodes          StoryNode[]
  storyEdges          StoryEdge[]
  scenes              Scene[]
  plots               Plot[]
  assetLinks          ProjectAssetLink[]
  storyNavigatorRuns  StoryNavigatorRun[]
  storyNavigatorExplorationRuns StoryNavigatorExplorationRun[]
  storyNavigatorObservations StoryNavigatorObservation[]
  defaultPovCharacter Character? @relation("ProjectDefaultPov", fields: [defaultPovCharacterId], references: [id], onDelete: SetNull)

  @@index([defaultPovCharacterId])
  @@schema("magic_story")
}

// ==========================================
// 模块二：项目管理 - 五类资产
// ==========================================

/// 大纲资产
model Outline {
  id        String  @id @default(cuid())
  projectId String
  content   String  @default("")
  version   Int     @default(1)
  tags      String  @default("[]") // JSON array of tags
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@schema("magic_story")
}

/// 角色资产（含AI生成图片）
model Character {
  id              String  @id @default(cuid())
  projectId       String
  name            String
  age             String  @default("")
  role            String  @default("主角")
  personality     String  @default("")
  appearance      String  @default("")
  background      String  @default("")
  arc             String  @default("")
  firstPerson     String  @default("")
  defaultSecondPerson String @default("")
  speechRegister  String  @default("")
  speechStyleNotes String @default("")
  narrationVoiceNotes String @default("")
  portraitUrl     String  @default("")  // AI生成的角色图片URL (base64 or URL)
  portraitPrompt  String  @default("")  // 自定义风格提示词
  tags            String  @default("[]") // JSON array of tags
  isFavorite      Boolean @default(false)
  version         Int     @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  fromRelations CharacterRelationship[] @relation("FromCharacter")
  toRelations   CharacterRelationship[] @relation("ToCharacter")
  defaultPovForProjects Project[] @relation("ProjectDefaultPov")
  povChapters Chapter[] @relation("ChapterPov")
  chapterCharacters ChapterCharacter[]
  knowledgeEvents CharacterKnowledge[]

  @@schema("magic_story")
}

model CharacterRelationship {
  id              String  @id @default(cuid())
  projectId       String
  fromCharacterId String
  toCharacterId   String
  type            String  @default("盟友")
  description     String  @default("")
  addressTerm      String @default("")
  speechRegister   String @default("")
  speechStyleNotes String @default("")

  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromCharacter Character @relation("FromCharacter", fields: [fromCharacterId], references: [id], onDelete: Cascade)
  toCharacter   Character @relation("ToCharacter", fields: [toCharacterId], references: [id], onDelete: Cascade)

  @@schema("magic_story")
}

/// 剧情资产
model Plot {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String   @default("")
  plotType    String   @default("main") // main | sub | task | dungeon | scene | event
  priority    Int      @default(0)
  status      String   @default("planned") // planned | active | completed | abandoned
  tags        String   @default("[]")
  order       Int      @default(0)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@schema("magic_story")
}

/// 场景资产
model Scene {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String   @default("")
  location    String   @default("")  // 场景地点
  atmosphere  String   @default("")  // 氛围描述
  timeOfDay   String   @default("")  // 时间段
  tags        String   @default("[]")
  order       Int      @default(0)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@schema("magic_story")
}

/// 世界观资产
model WorldSetting {
  id          String  @id @default(cuid())
  projectId   String
  name        String
  description String  @default("")
  rules       String  @default("")
  type        String  @default("background")
  order       Int     @default(0)
  tags        String  @default("[]")
  version     Int     @default(1)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@schema("magic_story")
}

/// 跨项目资产链接（浅拷贝引用）
model ProjectAssetLink {
  id           String   @id @default(cuid())
  projectId    String
  assetType    String   // outline | character | plot | scene | world
  sourceAssetId String  // 原资产ID
  sourceProjectId String // 原项目ID
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@schema("magic_story")
}

// ==========================================
// 模块一：创作中心 - 章节与对话
// ==========================================

model Chapter {
  id             String  @id @default(cuid())
  projectId      String
  order          Int
  title          String  @default("")
  outlineContent String  @default("")
  content        String  @default("")
  summary        String  @default("")
  wordCount      Int     @default(0)
  status         String  @default("draft")
  emotionTarget  String  @default("")
  emotionArc     String  @default("")
  hookStart      String  @default("")
  hookEnd        String  @default("")
  povCharacterId String?
  purpose         String @default("")
  targetWordCount Int?
  endingNotes     String @default("")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  storyStates StoryState[]
  foreshadowings Foreshadowing[]
  povCharacter Character? @relation("ChapterPov", fields: [povCharacterId], references: [id], onDelete: SetNull)
  chapterCharacters ChapterCharacter[]
  plannedStoryFacts StoryFact[] @relation("PlannedFactReveal")
  revealedStoryFacts StoryFact[] @relation("ActualFactReveal")
  knowledgeChanges CharacterKnowledge[]
  storyNavigatorRuns StoryNavigatorRun[]
  storyNavigatorExplorationAnchors StoryNavigatorExplorationRun[] @relation("ExplorationAnchor")
  storyNavigatorObservationSources StoryNavigatorObservation[] @relation("ObservationSource")

  @@index([povCharacterId])
  @@schema("magic_story")
}

model ChapterCharacter {
  chapterId     String
  characterId   String
  participation String @default("present")
  notes         String @default("")
  order         Int    @default(0)

  chapter   Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([chapterId, characterId])
  @@index([characterId])
  @@schema("magic_story")
}

model StoryState {
  id        String   @id @default(cuid())
  projectId String
  chapterId String
  type      String   @default("character_state")
  data      String   @default("{}")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@schema("magic_story")
}

model Foreshadowing {
  id                String  @id @default(cuid())
  projectId         String
  chapterId         String
  content           String  @default("")
  expectedResolveChapter Int @default(0)
  status            String  @default("planted")
  importance        String  @default("medium")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@schema("magic_story")
}

model StoryFact {
  id                     String   @id @default(cuid())
  projectId              String
  content                String
  importance             String   @default("medium")
  readerInitiallyKnows   Boolean  @default(false)
  plannedRevealChapterId String?
  revealedChapterId      String?
  notes                  String   @default("")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plannedRevealChapter Chapter? @relation("PlannedFactReveal", fields: [plannedRevealChapterId], references: [id], onDelete: SetNull)
  revealedChapter      Chapter? @relation("ActualFactReveal", fields: [revealedChapterId], references: [id], onDelete: SetNull)
  characterKnowledge   CharacterKnowledge[]

  @@index([projectId])
  @@index([plannedRevealChapterId])
  @@index([revealedChapterId])
  @@schema("magic_story")
}

model CharacterKnowledge {
  id                 String   @id @default(cuid())
  factId             String
  characterId        String
  status             String
  effectiveChapterId String?
  beliefNotes        String   @default("")
  notes              String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  fact             StoryFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  character        Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  effectiveChapter Chapter?  @relation(fields: [effectiveChapterId], references: [id], onDelete: Cascade)

  @@index([factId])
  @@index([characterId])
  @@index([effectiveChapterId])
  @@schema("magic_story")
}

model StoryNavigatorRun {
  id                    String   @id @default(cuid())
  projectId             String
  anchorChapterId       String
  request               String   @default("")
  promptVersion         String
  contextBuilderVersion String
  sourceManifest        String
  authorIntentSnapshot  String   @default("")
  genreGuidanceModeSnapshot String @default("reference")
  genreGuidanceNotesSnapshot String @default("")
  currentPositionSummary String  @default("")
  planDeviation         String   @default("[]")
  rawResponse           String   @default("")
  status                String   @default("pending")
  error                  String   @default("")
  createdAt             DateTime @default(now())
  completedAt           DateTime?

  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  anchorChapter Chapter @relation(fields: [anchorChapterId], references: [id], onDelete: Cascade)
  proposals     StoryNavigatorProposal[]

  @@index([projectId, createdAt])
  @@index([anchorChapterId])
  @@schema("magic_story")
}

model StoryNavigatorProposal {
  id                   String   @id @default(cuid())
  runId                String
  routeKey             String
  title                String
  summary              String
  whyPossible          String
  authorIntentRelation String
  preparation          String   @default("[]")
  affectedEntities     String   @default("[]")
  benefits             String   @default("[]")
  risks                String   @default("[]")
  immediateOptions     String   @default("[]")
  decisionStatus       String   @default("undecided")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  decidedAt            DateTime?

  run StoryNavigatorRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, routeKey])
  @@index([runId, decisionStatus])
  @@schema("magic_story")
}

model StoryNavigatorExplorationRun {
  id              String   @id @default(cuid())
  projectId       String
  anchorChapterId String
  rangeMode       String   @default("all")
  startChapterId  String?
  endChapterId    String?
  recentCount     Int?
  promptVersion   String
  sourceManifest  String
  status          String   @default("pending")
  error           String   @default("")
  processedBatches Int     @default(0)
  totalBatches     Int     @default(0)
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  anchorChapter Chapter @relation("ExplorationAnchor", fields: [anchorChapterId], references: [id], onDelete: Cascade)
  observations StoryNavigatorObservation[]

  @@index([projectId, createdAt])
  @@index([anchorChapterId])
  @@schema("magic_story")
}

model StoryNavigatorObservation {
  id                    String   @id @default(cuid())
  runId                 String
  projectId             String
  sourceChapterId       String
  sourceChapterOrder    Int
  sourceChapterTitle    String
  sourceExcerpt         String
  elementSummary        String
  reasonInteresting     String
  possibleUses          String   @default("[]")
  currentStoryRelation  String   @default("")
  authorIntentRelation  String   @default("")
  risks                 String   @default("[]")
  relevance             String   @default("medium")
  decisionStatus        String   @default("undecided")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  decidedAt             DateTime?

  run           StoryNavigatorExplorationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceChapter Chapter @relation("ObservationSource", fields: [sourceChapterId], references: [id], onDelete: Cascade)

  @@index([runId, decisionStatus])
  @@index([projectId, sourceChapterId])
  @@schema("magic_story")
}

// ==========================================
// 模块三：全景图谱 - 叙事地图
// ==========================================

/// 故事节点
model StoryNode {
  id          String   @id @default(cuid())
  projectId   String
  nodeType    String   @default("main") // main | sub | task | dungeon | scene | event
  title       String
  description String   @default("")
  positionX   Float    @default(0)
  positionY   Float    @default(0)
  metadata    String   @default("{}") // JSON: 关联角色ID、场景ID、伏笔等
  color       String   @default("")   // 自定义颜色
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceEdges StoryEdge[] @relation("SourceNode")
  targetEdges StoryEdge[] @relation("TargetNode")

  @@schema("magic_story")
}

/// 故事连线
model StoryEdge {
  id          String   @id @default(cuid())
  projectId   String
  sourceId    String
  targetId    String
  label       String   @default("")
  edgeType    String   @default("causal") // causal | temporal | character | foreshadow
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceNode StoryNode @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  targetNode StoryNode @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)

  @@schema("magic_story")
}

// ==========================================
// 共享模型
// ==========================================

model PromptTemplate {
  id        String  @id @default(cuid())
  projectId String
  name      String
  type      String  @default("general")
  content   String
  isDefault Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@schema("magic_story")
}

model AgentLog {
  id        String   @id @default(cuid())
  projectId String
  agentType String
  action    String
  input     String   @default("")
  output    String   @default("")
  toolCalls String   @default("[]") // JSON: 工具调用记录
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@schema("magic_story")
}
